@model global::PriceQModel.Models.PriceQModel

@{
    ViewData["Title"] = "Price Quotation Program";
}
<h1>Price Quotation Program</h1>
<p>This is a Price Quotation Calculator for Assignment 2 for CS-321.</p>
<h2>Calculator</h2>
<form asp-action="Index" method="post" class="mt-4">
    <div class="row mb-3 align-items-center">
        <label asp-for="Subtotal" class="col-sm-4 col-form-label">Subtotal:</label>
        <div class="col-sm-8">
            <input asp-for="Subtotal" class="form-control" />
            <span asp-validation-for="Subtotal" class="text-danger"></span>
        </div>
    </div>
    <div class="row mb-3 align-items-center">
        <label asp-for="Discount_Amount" class="col-sm-4 col-form-label">Discount Percentage:</label>
        <div class="col-sm-8">
            <input asp-for="Discount_Amount" class="form-control" />
            <span asp-validation-for="Discount_Amount" class="text-danger"></span>
        </div>
    </div>
    <div class="row mb-3 align-items-center">
        <label class="col-sm-4 col-form-label">Discount Amount:</label>
        <div class="col-sm-8">
            <input class="form-control" value="@(Model.DiscountAmount?.ToString("C2") ?? "")" readonly />
        </div>
    </div>
    <div class="row mb-3 align-items-center">
        <label class="col-sm-4 col-form-label">Total Amount:</label>
        <div class="col-sm-8">
            <input class="form-control" value="@(Model.CalculationPriceQ?.ToString("C2") ?? "")" readonly />
        </div>
    </div>
    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-primary">Calculate</button>
    <a asp-action="Index" class="btn btn-clear">Clear</a>
    </div>
</form>